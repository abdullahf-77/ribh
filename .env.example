# Any OpenAI-compatible host. Models must be Llama or named in LLAMA_EXTRA_ALLOWED_MODELS. Without LLAMA_API_KEY the app runs in labelled demo mode.
LLAMA_API_KEY=
LLAMA_BASE_URL=https://openrouter.ai/api/v1
LLAMA_MODEL=meta-llama/llama-4-maverick
# Optional
# LLAMA_TIMEOUT_MS=40000
# LLAMA_MAX_ATTEMPTS=2
# NEXT_PUBLIC_BRAND_NAME_AR=رِبح
# NEXT_PUBLIC_BRAND_NAME_EN=Ribh
# Hosts tried first for the same model, comma separated.
# LLAMA_HOST_ORDER=parasail
# Optional second Llama host, used only after the first one fails. Must serve a Llama model.
# LLAMA_FALLBACK_API_KEY=
# LLAMA_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# LLAMA_FALLBACK_MODEL=meta-llama/llama-4-maverick
# Non-Llama models the owner allows, comma separated.
# LLAMA_EXTRA_ALLOWED_MODELS=
# Caps output on the main host, for hosts with a low per-minute output limit.
# LLAMA_MAX_OUTPUT_TOKENS=
